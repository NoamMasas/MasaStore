[mysqld]
# e2-micro has 1 GB RAM shared with Redis and the OS; MySQL defaults use ~400 MB.
performance_schema      = OFF
innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 8M
max_connections         = 30
table_open_cache        = 200
thread_cache_size       = 4
tmp_table_size          = 16M
max_heap_table_size     = 16M
